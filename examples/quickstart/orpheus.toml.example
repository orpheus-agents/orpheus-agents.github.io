[services.mattermost]
name = "Mattermost"
description = "Read channels and publish messages through the bot."
delivery = "direct"
endpoint = "https://chat.example.com"

[services.mattermost.credentials]
bot = { env = "MATTERMOST_BOT_TOKEN" }

[services.mattermost.environment]
MATTERMOST_URL = { from = "endpoint" }
