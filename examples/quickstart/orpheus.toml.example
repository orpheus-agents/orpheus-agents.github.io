[templates.codex]
description = "Codex sandbox"

[profiles.default]
harness = "codex"
model = "gpt-6-sol"

[profiles.default.auth]
mode = "api_key"
api_key_env = "OPENAI_API_KEY"

[services.mattermost]
name = "Mattermost"
description = "Read channels and publish messages through the bot."
env_from = ["MATTERMOST_BOT_TOKEN"]
